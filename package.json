{
  "name": "harborline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite --host 127.0.0.1",
    "preview": "pnpm build && wrangler dev --local --port 8787",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:redirect": "wrangler deploy -c wrangler.redirect.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types scripts/check-routes.mjs",
    "favicon": "node scripts/make-favicon.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.2",
    "hono": "^4.11.2",
    "lucide-react": "^0.563.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251218.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.62.0"
  }
}
