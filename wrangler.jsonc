{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "harborline",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-05-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // Both hostnames are custom domains, not zone routes. A zone route only
  // intercepts a hostname that already resolves through the proxy — it creates
  // no DNS record of its own — so the apex, which has none, resolved nowhere
  // and the route never fired. A custom domain creates and keeps the record.
  "routes": [
    {
      "pattern": "theharborline.co",
      "custom_domain": true
    },
    {
      "pattern": "www.theharborline.co",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
