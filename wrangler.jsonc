{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pdx-software",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-05-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "harborline.cloud/*",
      "zone_name": "harborline.cloud"
    },
    {
      "pattern": "www.harborline.cloud/*",
      "zone_name": "harborline.cloud"
    },
    {
      "pattern": "pdx.software/*",
      "zone_name": "pdx.software"
    },
    {
      "pattern": "www.pdx.software/*",
      "zone_name": "pdx.software"
    }
  ],
  "observability": {
    "enabled": true
  }
}
