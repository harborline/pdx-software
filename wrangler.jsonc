{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "harborline",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-05-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "theharborline.co/*",
      "zone_name": "theharborline.co"
    },
    {
      "pattern": "www.theharborline.co",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
